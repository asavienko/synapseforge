#!/bin/sh

echo "🔍 Running pre-push checks..."

cd web

echo "⬡ TypeScript type check..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors found. Push aborted. Fix type errors first."
  exit 1
fi

echo "🧹 Running linter..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ Lint errors found. Push aborted. Fix lint errors first."
  exit 1
fi

echo "🌍 Checking translation completeness..."
node scripts/check-translations.js
# Non-zero exit only on JSON parse errors (strict mode not enabled by default).
# To block push on any missing key, change to: node scripts/check-translations.js --strict
if [ $? -ne 0 ]; then
  echo "❌ Translation check failed (JSON parse error). Fix messages/*.json before pushing."
  exit 1
fi

echo "✅ All checks passed — pushing."
