#!/bin/sh

echo "🔍 Running pre-push checks..."

cd web

echo "⬡ TypeScript type check..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors found. Push aborted. Fix type errors first."
  exit 1
fi

echo "🧹 Running linter..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ Lint errors found. Push aborted. Fix lint errors first."
  exit 1
fi

echo "✅ All checks passed — pushing."
