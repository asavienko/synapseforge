{
  "name": "openhelix-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "check-env": "node scripts/check-env.js",
    "test:unit": "echo 'No unit tests yet'",
    "test:integration": "echo 'No integration tests yet'",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:headed": "cypress run --headed",
    "test:e2e": "start-server-and-test dev http://localhost:3000 cy:run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:seed": "npx tsx cypress/support/seed.ts",
    "migrate:embeddings": "tsx scripts/migrate-embeddings.ts",
    "prepare": "node -e \"if(process.env.CI||process.env.VERCEL)process.exit(0)\" || (cd .. && node web/node_modules/.bin/husky)"
  },
  "overrides": {
    "@swc/helpers": "0.5.19"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/openai": "^3.0.41",
    "@ai-sdk/react": "^3.0.118",
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1008.0",
    "@aws-sdk/s3-request-presigner": "^3.1008.0",
    "@calcom/embed-react": "^1.5.3",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/client": "^5.22.0",
    "@scalar/nextjs-api-reference": "^0.10.3",
    "@sentry/nextjs": "^10.43.0",
    "@stripe/stripe-js": "^8.9.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/zxcvbn": "^4.4.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^6.0.116",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "ioredis": "^5.10.0",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "next-intl": "^4.8.3",
    "openai": "^6.27.0",
    "pdf-parse": "^2.4.5",
    "posthog-js": "^1.360.1",
    "posthog-node": "^5.28.1",
    "prisma": "^5.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.3",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1",
    "tailwind-merge": "^3.5.0",
    "zxcvbn": "^4.4.2"
