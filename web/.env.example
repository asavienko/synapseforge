# ─────────────────────────────────────────────────────────────────────────────
# SynapseForge — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Neon / Postgres) ───────────────────────────────────────────────
# Pooled URL for most queries; DIRECT_URL for migrations/Prisma schema push
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="your-strong-random-secret-here"
# Public URL of the app (no trailing slash)
NEXTAUTH_URL="https://yourdomain.com"
# APP_URL is a fallback used by cloud-init; defaults to NEXTAUTH_URL if not set
APP_URL="https://yourdomain.com"

# ── Credential Encryption ────────────────────────────────────────────────────
# Used to encrypt LLM + channel API keys stored in the database.
# REQUIRED — the app will crash on startup without this.
# Generate: openssl rand -hex 32   (must be 32+ characters)
ENCRYPTION_KEY="your-32-char-encryption-key-here!"

# ── Internal API (VPS ↔ SynapseForge) ────────────────────────────────────────
# Shared secret used by deployed VPS instances to authenticate health-check
# and config-sync callbacks to /api/internal/*.
# REQUIRED for VPS provisioning to work.
# Generate: openssl rand -hex 32
INTERNAL_API_KEY="your-internal-api-key-here"

# ── Admin access ─────────────────────────────────────────────────────────────
# Comma-separated emails allowed to access /admin and admin API endpoints
ADMIN_EMAILS="admin@yourdomain.com"
# Optional: separate API key for admin automation (not used in UI)
# ADMIN_API_KEY="your-admin-api-key"

# ── Cloud VPS Provisioning (Hetzner) ─────────────────────────────────────────
# Required to provision VPS instances for users.
# Get from: https://console.hetzner.cloud/ → Project → API Tokens → Generate
# Without this, the Deploy button returns 503 "not available on this platform".
HETZNER_API_KEY="your-hetzner-api-token"

# ── Resend (transactional email) ─────────────────────────────────────────────
# Get from: https://resend.com/api-keys
# Without this, emails are logged to console but not sent.
RESEND_API_KEY="re_..."
# Sender address — must be a verified domain in Resend
RESEND_FROM="SynapseForge <hello@yourdomain.com>"

# ── Stripe (billing) ─────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."
# Get from: https://dashboard.stripe.com/products (create Pro + Enterprise products)
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_ENTERPRISE_PRICE_ID="price_..."

# ── CI / Testing only ─────────────────────────────────────────────────────────
# Set DISABLE_RATE_LIMIT=true in CI to skip rate limiting during Cypress tests
# DISABLE_RATE_LIMIT=true

# ── PostHog (analytics) ───────────────────────────────────────────────────────
# Get from: https://app.posthog.com/project/settings
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_KEY=phc_...
POSTHOG_HOST=https://eu.i.posthog.com

# ── Cron jobs ─────────────────────────────────────────────────────────────────
# Shared secret for Vercel Cron routes — set in Vercel env vars and locally
CRON_SECRET="your-secret-cron-key-here"

# ── Google OAuth ────────────────────────────────────────────────────────────
# Required for Google Sign-In. Get from: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 credentials and add authorized redirect URIs:
#   - http://localhost:3000/api/auth/callback/google (local dev)
#   - https://yourdomain.com/api/auth/callback/google (production)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Set to "true" to show the Google Sign-In button on login/signup pages
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="true"

# ── Sandbox mode ──────────────────────────────────────────────────────────────
# Platform OpenAI key for sandbox mode (used when users don't have their own key)
SYNAPSEFORGE_OPENAI_KEY=sk-...

# ── Meta / WhatsApp Business API ─────────────────────────────────────────────
# Required for WhatsApp Business API integration via Meta
# Get from: https://developers.facebook.com/apps/ → Create App → Business → WhatsApp
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
# This is automatically set by the app, but can be overridden for local dev
# NEXT_PUBLIC_APP_URL="https://yourdomain.com"
