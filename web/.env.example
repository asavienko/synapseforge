# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://user:password@localhost:5432/synapseforge"
DIRECT_URL="postgresql://user:password@localhost:5432/synapseforge"

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Secret for JWT signing (Required in production)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth ────────────────────────────────────────────────────────────
# Optional - for Google Sign-In
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Required for email verification, password reset, notifications
# Get from: https://resend.com
RESEND_API_KEY="re_xxxxxxxx"
# The "from" address must be verified in Resend
EMAIL_FROM="noreply@openhelixai.com"

# ── Encryption ───────────────────────────────────────────────────────────────
# Required for encrypting API keys and sensitive data
# Must be exactly 32 characters
ENCRYPTION_KEY="your-32-char-encryption-key-here!!"

# ── Internal API ─────────────────────────────────────────────────────────────
# For internal service communication
INTERNAL_API_KEY="your-internal-api-key"

# ── Admin Emails ─────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses
ADMIN_EMAILS="admin@openhelixai.com"

# ── Cron Secret ──────────────────────────────────────────────────────────────
# For securing cron job endpoints
CRON_SECRET="your-cron-secret"

# ── Redis (Optional) ─────────────────────────────────────────────────────────
# For rate limiting and caching
# If not set, in-memory rate limiting will be used
REDIS_URL=""

# ── Feature Flags ────────────────────────────────────────────────────────────
# Disable rate limiting in CI/test environments
DISABLE_RATE_LIMIT="false"
