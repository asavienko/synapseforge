{
  "buildCommand": "prisma generate && next build",
  "installCommand": "HUSKY=0 npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/internal/provision-timeout",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/plan-enforcement",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/check-milestones",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/check-inactivity",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/update-health-scores",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/internal/auto-snapshot",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/auto-update",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/sandbox-nudge",
      "schedule": "0 */6 * * *"
    }
  ]
}
