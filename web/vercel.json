{
  "buildCommand": "prisma generate && next build",
  "installCommand": "HUSKY=0 npm install",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/health-check",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/internal/provision-timeout",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/plan-enforcement",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/update-health-scores",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/internal/auto-snapshot",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/auto-update",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/provision-poll",
      "schedule": "0 0 * * *"
    }
  ]
}
