generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String       @unique
  emailVerified DateTime?
  image         String?
  password      String?
  plan          String       @default("free") // free | pro | enterprise
  onboardingDone Boolean     @default(false)
  onboardingData String?     // JSON: { business, industry, useCase }
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  stripePriceId        String?
  stripeCurrentPeriodEnd DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  managerId     String?
  manager       Manager?     @relation(fields: [managerId], references: [id])

  instances     AIInstance[]
  accounts      Account[]
  sessions      Session[]
  messages      Message[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expires   DateTime
  createdAt DateTime @default(now())
}

model Manager {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  createdAt DateTime  @default(now())
  users     User[]
  messages  Message[]
}

model Message {
  id          String   @id @default(cuid())
  body        String
  senderType  String   // "user" | "manager"
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId      String
  managerId   String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager     Manager  @relation(fields: [managerId], references: [id], onDelete: Cascade)
}

model AIInstance {
  id            String    @id @default(cuid())
  name          String
  type          String    @default("assistant") // assistant | analyst | support | custom
  status        String    @default("stopped")  // running | stopped | pending | error
  tier          String    @default("minimal")  // minimal | standard | pro
  description   String?
  config        String?   // JSON blob: { model, systemPrompt, temperature, maxTokens }
  healthStatus  String?   // "healthy" | "degraded" | "down" | null (unknown)
  lastCheckedAt DateTime?
  lastBackupAt  DateTime?
  vpsUrl        String?   // e.g. "http://1.2.3.4:3000" — OpenClaw gateway URL on the client VPS
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys       ApiKey[]
  logs          ActivityLog[]
  healthChecks  HealthCheck[]
  snapshots     Snapshot[]
}

model HealthCheck {
  id         String     @id @default(cuid())
  instanceId String
  status     String     // "healthy" | "degraded" | "down"
  responseMs Int?       // response time in milliseconds
  error      String?    // error message if down/degraded
  checkedAt  DateTime   @default(now())
  instance   AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model Snapshot {
  id         String     @id @default(cuid())
  instanceId String
  snapshotId String     // Restic snapshot short ID
  sizeBytes  Int?       // size in bytes
  healthy    Boolean    @default(true) // was the instance healthy at snapshot time?
  createdAt  DateTime   @default(now())
  instance   AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String    @default("Default")
  key        String    @unique
  preview    String    // e.g. "sf-live-abcd...wxyz"
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  instanceId String
  instance   AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         String   @id @default(cuid())
  event      String   // started | stopped | config_changed | key_generated | key_revoked | created | deleted
  details    String?
  createdAt  DateTime @default(now())

  instanceId String
  instance   AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
