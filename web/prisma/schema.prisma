generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String    @id @default(cuid())
  name                   String?
  email                  String    @unique
  emailVerified          DateTime?
  image                  String?
  password               String?
  plan                   String    @default("free") // free | starter_10k | growth_30k | scale_100k | business_200k | managed_*
  onboardingDone         Boolean   @default(false)
  onboardingData         Json?     // { industry, useCase, teamSize, agentType, businessName }
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  stripeCancelAtPeriodEnd Boolean  @default(false)
  stripePaymentFailedAt  DateTime?
  stripePaymentFailedInvoiceId String?
  activatedAt            DateTime? // Set when first real chat message sent
  healthScore            Int? // 0-100, computed by cron daily
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  managerId String?
  manager   Manager? @relation(fields: [managerId], references: [id])

  referralCode String?             @unique // auto-generated on first request
  managerNotes ClientNote[]
  referrals    Referral[]          @relation("ReferrerUser")
  referredBy   ReferralConversion? @relation("ReferredUser")

  instances        AIInstance[]
  accounts         Account[]
  sessions         Session[]
  messages         Message[]
  notifications    Notification[]
  webhooks         Webhook[]
  whiteLabelConfig WhiteLabelConfig?
  credentials      UserCredential[]
  usageEvents      UsageEvent[]
}

model Referral {
  id         String   @id @default(cuid())
  code       String   @unique // "ANTON-X7K2"
  referrerId String
  referrer   User     @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  conversions ReferralConversion[]
}

model ReferralConversion {
  id               String    @id @default(cuid())
  referralId       String
  referral         Referral  @relation(fields: [referralId], references: [id], onDelete: Cascade)
  referredUserId   String    @unique
  referredUser     User      @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  status           String    @default("pending") // "pending" | "converted" | "paid"
  planAtConversion String? // "pro" | "enterprise"
  commissionUsd    Float? // calculated when subscription starts
  monthsRemaining  Int       @default(6)
  createdAt        DateTime  @default(now())
  convertedAt      DateTime?
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expires   DateTime
  createdAt DateTime @default(now())
}

model ClientInvite {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  email     String
  name      String
  managerId String?
  userId    String?  // set after account created
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Manager {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  calLink   String? // e.g. "john-smith/30min" — Cal.com path (no leading slash, no https)
  createdAt DateTime     @default(now())
  users     User[]
  messages  Message[]
  notes     ClientNote[]
}

model ClientNote {
  id        String   @id @default(cuid())
  managerId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  manager   Manager  @relation(fields: [managerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WhiteLabelConfig {
  id            String   @id @default(cuid())
  userId        String   @unique
  brandName     String   @default("SynapseForge")
  brandColor    String   @default("#7c3aed")
  logoUrl       String?
  customDomain  String?
  hidePoweredBy Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  body       String
  senderType String // "user" | "manager"
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  userId    String
  managerId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager   Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // "instance.down" | "manager.message" | "milestone" | "provision.ready" | "instance.deployed"
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIInstance {
  id                  String    @id @default(cuid())
  name                String
  type                String    @default("assistant") // assistant | analyst | support | custom
  status              String    @default("stopped") // running | stopped | pending | error
  tier                String    @default("minimal") // minimal | standard | pro
  description         String?
  config              String? // JSON blob: { model, systemPrompt, temperature, maxTokens }
  healthStatus        String? // "healthy" | "degraded" | "down" | null (unknown)
  lastCheckedAt       DateTime?
  lastBackupAt        DateTime?
  vpsUrl              String? // e.g. "http://1.2.3.4:3000" — OpenClaw gateway URL on the client VPS
  gatewayToken        String? // Bearer token for OpenClaw gateway auth
  // Provisioning
  provisionStatus     String? // "pending" | "provisioning" | "ready" | "failed"
  vpsProvider         String? // "hetzner" (only supported for now)
  vpsServerId         String? // Hetzner server numeric ID
  bootstrapToken      String? // One-time token for config delivery to VPS
  bootstrapUsed       Boolean   @default(false)
  configSynced        Boolean   @default(true) // false when credentials changed but not pushed to VPS
  syncRequested       Boolean   @default(false) // user clicked "Sync Now" — VPS will pick up on next poll
  telegramBotUsername String? // e.g. "@MyBot" — set after successful Telegram setup
  discordBotUsername  String? // Discord bot username — set after successful Discord setup
  discordBotId        String? // Discord bot application ID — used to build invite URL
  slackBotName        String? // Slack bot display name — set after successful Slack setup
  slackTeamName       String? // Slack workspace name — set after successful Slack setup
  // WhatsApp Business API (Meta)
  whatsappEnabled      Boolean? @default(false)
  whatsappPhoneNumber  String? // Business phone number
  whatsappAccountId    String? // Meta Business account ID (WABA ID)
  whatsappBusinessName String? // Display name for the business
  whatsappApiKey       String? // Encrypted - Meta app secret for webhook verification
  whatsappAccessToken  String? // Encrypted - Meta access token
  whatsappWebhookSecret String? // Encrypted - Webhook verification secret
  sshPrivateKey       String? // Encrypted ED25519 private key for config updates
  currentVersion      String? // Currently running OpenClaw version tag
  targetVersion       String? // Desired version (set by admin or auto-update)
  autoUpdate          Boolean   @default(false) // Auto-update to latest stable
  versionLockedAt     DateTime? // When version was locked/pinned
  sandboxMode         Boolean   @default(true) // true = use platform key, false = use own key
  sandboxUsed         Int       @default(0) // messages used in sandbox
  consecutiveFailures Int       @default(0) // consecutive health check failures
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeys          ApiKey[]
  logs             ActivityLog[]
  healthChecks     HealthCheck[]
  snapshots        Snapshot[]
  machineSnapshots MachineSnapshot[]
  commands         InstanceCommand[]
  credentials      InstanceCredential[]
  chatMessages     ChatMessage[]
  webhooks         Webhook[]
  knowledgeBase    KnowledgeBase?
  migrations       MigrationJob[]
  usageEvents      UsageEvent[]
}

model KnowledgeBase {
  id         String         @id @default(cuid())
  instanceId String         @unique
  name       String         @default("Knowledge Base")
  createdAt  DateTime       @default(now())
  instance   AIInstance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  documents  KnowledgeDoc[]

  @@map("knowledge_base")
}

model KnowledgeDoc {
  id              String           @id @default(cuid())
  knowledgeBaseId String
  filename        String
  fileSize        Int
  type            String           @default("txt") // "pdf" | "docx" | "txt" | "md"
  status          String           @default("processing") // "processing" | "ready" | "error"
  contentText     String?          // Full extracted text (optional, for search/debug)
  chunkCount      Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  knowledgeBase   KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks          KnowledgeChunk[]
}

model KnowledgeChunk {
  id        String                 @id @default(cuid())
  docId     String
  content   String
  embedding Unsupported("vector")?
  metadata  String? // JSON: { page?: number, startChar?: number, endChar?: number }
  createdAt DateTime               @default(now())
  doc       KnowledgeDoc           @relation(fields: [docId], references: [id], onDelete: Cascade)
}

model InstanceCredential {
  id         String   @id @default(cuid())
  instanceId String
  key        String // e.g. "openai_api_key", "telegram_bot_token"
  value      String // AES-256-GCM encrypted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  instance AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, key])
}

model HealthCheck {
  id         String     @id @default(cuid())
  instanceId String
  status     String // "healthy" | "degraded" | "down"
  responseMs Int? // response time in milliseconds
  error      String? // error message if down/degraded
  checkedAt  DateTime   @default(now())
  instance   AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model Snapshot {
  id          String     @id @default(cuid())
  instanceId  String
  snapshotId  String // Restic snapshot short ID
  sizeBytes   Int? // size in bytes
  healthy     Boolean    @default(true) // was the instance healthy at snapshot time?
  label       String?
  tag         String?
  triggeredBy String?
  createdAt   DateTime   @default(now())
  instance    AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model InstanceCommand {
  id          String     @id @default(cuid())
  instanceId  String
  type        String // "update_version" | "rollback_restic" | "take_restic_snapshot" | "rollback_machine" | "restart"
  payload     String? // JSON
  status      String     @default("pending") // "pending" | "running" | "done" | "failed"
  requestedBy String?
  note        String?
  createdAt   DateTime   @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  errorMsg    String?
  instance    AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, status])
}

model MachineSnapshot {
  id             String     @id @default(cuid())
  instanceId     String
  hetznerImageId String
  sizeGb         Float?
  status         String     @default("creating") // "creating" | "ready" | "failed"
  label          String?
  createdAt      DateTime   @default(now())
  instance       AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model OpenClawVersion {
  id          String   @id @default(cuid())
  tag         String   @unique
  imageRef    String
  changelog   String?
  stable      Boolean  @default(false)
  deprecated  Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String    @default("Default")
  key        String    @unique
  preview    String // e.g. "sf-live-abcd...wxyz"
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  instanceId String
  instance   AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  event     String // started | stopped | config_changed | key_generated | key_revoked | created | deleted
  details   String?
  createdAt DateTime @default(now())

  instanceId String
  instance   AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id           String   @id @default(cuid())
  instanceId   String
  role         String // "user" | "assistant"
  content      String
  isError      Boolean  @default(false)
  latencyMs    Int?
  provider     String?
  model        String?
  inputTokens  Int? // prompt token count returned by the LLM provider
  outputTokens Int? // completion token count returned by the LLM provider
  source       String? // "dashboard" | "api" | "api/openai-compat"
  intent       String? // Conversation intelligence: booking, pricing, complaint, faq, out_of_scope, other
  wasAnswered  Boolean  @default(true) // Conversation intelligence: was the user's question answered
  createdAt    DateTime @default(now())

  instance AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Webhook {
  id         String      @id @default(cuid())
  userId     String
  instanceId String?
  url        String
  events     String // comma-separated: "chat.message,instance.deployed,instance.down"
  secret     String      @default(cuid()) // Used to sign payloads
  active     Boolean     @default(true)
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance   AIInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    String
  statusCode Int?
  response   String?
  success    Boolean
  error      String?
  createdAt  DateTime @default(now())
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?
  createdAt DateTime @default(now())
}

model MigrationJob {
  id          String    @id @default(cuid())
  instanceId  String
  type        String // "knowledge_embeddings" | "other"
  status      String    @default("pending") // "pending" | "queued" | "running" | "completed" | "failed"
  progress    Int       @default(0) // 0-100
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  error       String?
  logs        String? // JSON string with detailed logs
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  instance AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, createdAt])
}

// User-level credential vault for LLM provider API keys
model UserCredential {
  id           String   @id @default(cuid())
  userId       String
  provider     String // "openai" | "anthropic" | "openrouter"
  encryptedKey String // AES-256-GCM encrypted API key
  lastFour     String // Last 4 chars of key for display (e.g., "x7k2")
  isDefault    Boolean  @default(false) // Whether this is the default key for the provider
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// Usage tracking for billing and analytics
model UsageEvent {
  id         String   @id @default(cuid())
  userId     String
  instanceId String
  type       String // "chat" | "api_call" | "token"
  count      Int     @default(1)
  metadata   String? // JSON string with additional data
  createdAt  DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance AIInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([instanceId, createdAt])
  @@index([type, createdAt])
}

// User feedback submissions
model Feedback {
  id        String   @id @default(cuid())
  message   String
  userId    String?
  userEmail String?
  source    String   @default("dashboard_widget") // Where the feedback came from
  metadata  Json?    // Additional context (userAgent, page URL, etc.)
  status    String   @default("new") // new | read | resolved | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

// Analytics events for tracking user behavior
model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String   // Event name (e.g., "page_view", "button_click")
  properties Json?   // Event properties
  userId    String?
  url       String?
  userAgent String?
  timestamp DateTime @default(now())

  @@index([event, timestamp])
  @@index([userId])
  @@index([timestamp])
}

// Team members for collaboration
model TeamMember {
  id          String   @id @default(cuid())
  ownerId     String   // User who invited
  email       String
  role        String   // "admin" | "viewer"
  status      String   // "pending" | "active"
  inviteToken String?  @unique
  joinedAt    DateTime?
  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@index([email])
  @@index([inviteToken])
}
